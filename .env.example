SIGAA_URL=https://sigaa.sua-faculdade.edu.br
SIGAA_USERNAME=seu_usuario_sigaa
SIGAA_PASSWORD=sua_senha_sigaa

# O bot usa o e-mail academico para ler notificacoes do SIGAA.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=seu_email@academico.edu.br
EMAIL_PASSWORD=sua_senha_ou_senha_de_app
EMAIL_FOLDER=INBOX
EMAIL_LOOKBACK_DAYS=30
EMAIL_SIGAA_FROM=

# E-mail usado para enviar avisos para voce.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu_email@academico.edu.br
SMTP_PASSWORD=sua_senha_ou_senha_de_app
NOTIFY_TO=seu_email_pessoal@exemplo.com

# Calendario: use outlook, google, both ou none.
CALENDAR_PROVIDER=outlook

# Google Calendar.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_SECRET_FILE=credentials/google_client_secret.json
GOOGLE_TOKEN_FILE=credentials/google_token.json

# Outlook/Microsoft Graph Calendar.
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=common
OUTLOOK_TOKEN_CACHE_FILE=credentials/outlook_token_cache.bin
# Use primary para calendario padrao ou informe o ID de outro calendario.
OUTLOOK_CALENDAR_ID=primary

# Google Classroom.
CLASSROOM_ENABLED=true
CLASSROOM_TOKEN_FILE=credentials/google_classroom_token.json
# Opcional: informe IDs dos cursos separados por virgula para monitorar apenas eles.
CLASSROOM_COURSE_IDS=

# Saidas locais.
DATABASE_PATH=data/bot_faculdade.sqlite3
ICS_OUTPUT_PATH=exports/agenda_faculdade.ics

# Regras do alerta.
ALERT_DAYS_BEFORE=3
REMINDER_DAYS=7,3,1,0
TIMEZONE=America/Sao_Paulo

# Noticias pertinentes do SIGAA/e-mail. Separe por virgula.
NEWS_KEYWORDS=curso,coordenacao,coordenação,matricula,matrícula,estagio,estágio,edital,bolsa,evento,palestra,monitoria,oportunidade,seminario,seminário,certificado,calendario,calendário
URGENT_KEYWORDS=cancelamento,cancelado,adiado,matricula,matrícula,prazo final,prova,edital,urgente

# Dashboard e backup.
DASHBOARD_OUTPUT_PATH=exports/dashboard.html
ICS_BACKUP_DIR=exports/backups
ICS_BACKUP_ENABLED=true
SUMMARY_DAYS_AHEAD=7

# Materiais de estudo para provas.
STUDY_MATERIALS_DIR=materials/provas
STUDY_MATERIAL_LOOKBACK_DAYS=120
STUDY_MATERIAL_EXTENSIONS=.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.zip,.rar,.txt,.png,.jpg,.jpeg

# Telegram opcional. Deixe vazio para desativar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Se true, o navegador abre para ajudar a ajustar login/seletores do SIGAA.
SIGAA_HEADLESS=true
# Se true, o bot abre o navegador e espera voce fazer login manualmente.
SIGAA_MANUAL_LOGIN=false
